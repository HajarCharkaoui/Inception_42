[server]

[mysqld]
user                    = mysql
pid-file                = /run/mysqld/mysqld.pid
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp
lc-messages-dir         = /usr/share/mysql

# Khass MariaDB t-sme3 l ga3 l-interfaces réseau dakheliya
bind-address            = 0.0.0.0

# Port standard d MySQL
port                    = 3306